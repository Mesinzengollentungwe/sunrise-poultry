# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# ---- MTN Mobile Money (MoMo) Collections API ----
# Get these from https://momodeveloper.mtn.com after subscribing to the "Collections" product
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_CALLBACK_URL=http://localhost:4000/api/payments/momo/webhook

# ---- Orange Money (Cameroon) Web Payment API ----
# Get these from https://developer.orange.com/apis/om-webpay
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_BASE_URL=https://api.orange.com
ORANGE_RETURN_URL=http://localhost:5173/order-confirmation
ORANGE_CANCEL_URL=http://localhost:5173/checkout
ORANGE_NOTIF_URL=http://localhost:4000/api/payments/orange/webhook
